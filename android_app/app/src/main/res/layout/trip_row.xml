<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/trip_card"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tripTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#181D27"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tripTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#6D7784"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tripStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#C52C4E"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/tripRevisionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/tripReviseTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="修改时间"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/tripDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:minHeight="40dp"
            android:text="删除"
            android:textAllCaps="false"
            android:textColor="#B3261E" />
    </LinearLayout>
</LinearLayout>
